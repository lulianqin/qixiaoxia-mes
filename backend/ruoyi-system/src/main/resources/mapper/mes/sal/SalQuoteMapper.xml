            <if test="goodsType != null">goods_type,</if>
            <if test="inquiryDate != null">inquiry_date,</if>
            <if test="budget != null">budget,</if>
            <if test="attachment != null">attachment,</if>
            <if test="status != null">status,</if>
            <if test="remark != null">remark,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="quoteCode != null and quoteCode != ''">#{quoteCode},</if>
            <if test="externalQuoteId != null">#{externalQuoteId},</if>
            <if test="externalQuoteNo != null and externalQuoteNo != ''">#{externalQuoteNo},</if>
            <if test="sourceSystem != null">#{sourceSystem},</if>
            <if test="title != null">#{title},</if>
            <if test="clientCode != null">#{clientCode},</if>
            <if test="clientName != null">#{clientName},</if>
            <if test="goodsType != null">#{goodsType},</if>
            <if test="inquiryDate != null">#{inquiryDate},</if>
            <if test="budget != null">#{budget},</if>
            <if test="attachment != null">#{attachment},</if>
            <if test="status != null">#{status},</if>
            <if test="remark != null">#{remark},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
        </trim>
    </insert>

    <update id="updateSalQuote" parameterType="SalQuote">
        update qxx_sal_quote
        <trim prefix="SET" suffixOverrides=",">
            <if test="quoteCode != null and quoteCode != ''">quote_code = #{quoteCode},</if>
