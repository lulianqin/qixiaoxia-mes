    <sql id="selectSalQuoteVo">
        select quote_id, factory_id, quote_code, external_quote_id, external_quote_no, source_system,
               title, client_code, client_name, client_id, goods_type, inquiry_date, budget, attachment, status,
               quote_user, quote_time, total_amount, return_reason, return_time, sync_status, sync_time,
               remark, create_by, create_time, update_by, update_time
        from qxx_sal_quote
    </sql>

    <sql id="selectSalQuoteLineVo">
        select line_id, factory_id, quote_id, line_no, external_line_id, product_code, product_name, product_id,
               product_photo, product_size, structure, material, printing_mode, process_txt, accessory_txt,
               quantity, unit, price, quote_remark, delivery_date, quote_valid_date, remark,
               create_by, create_time, update_by, update_time
        from qxx_sal_quote_line
    </sql>

    <select id="selectSalQuoteByQuoteId" parameterType="Long" resultMap="SalQuoteResult">
        <include refid="selectSalQuoteVo"/>
        where quote_id = #{quoteId} and del_flag = '0'
    </select>

    <select id="selectSalQuoteByExternalNo" parameterType="String" resultMap="SalQuoteResult">
        <include refid="selectSalQuoteVo"/>
        where external_quote_no = #{externalQuoteNo} and del_flag = '0' limit 1
    </select>

    <select id="selectSalQuoteList" parameterType="SalQuote" resultMap="SalQuoteResult">
        <include refid="selectSalQuoteVo"/>
        <where>
            and del_flag = '0'
            <if test="quoteCode != null and quoteCode != ''"> and quote_code like concat('%', #{quoteCode}, '%')</if>
            <if test="externalQuoteNo != null and externalQuoteNo != ''"> and external_quote_no like concat('%', #{externalQuoteNo}, '%')</if>
            <if test="title != null and title != ''"> and title like concat('%', #{title}, '%')</if>
            <if test="clientName != null and clientName != ''"> and client_name like concat('%', #{clientName}, '%')</if>
            <if test="status != null and status != ''"> and status = #{status}</if>
            <if test="statusList != null and statusList.size() > 0">
                and status in
                <foreach collection="statusList" item="st" open="(" separator="," close=")">#{st}</foreach>
            </if>
        </where>
        order by quote_id desc
    </select>

    <insert id="insertSalQuote" parameterType="SalQuote" useGeneratedKeys="true" keyProperty="quoteId">
        insert into qxx_sal_quote
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="quoteCode != null and quoteCode != ''">quote_code,</if>
            <if test="externalQuoteId != null">external_quote_id,</if>
            <if test="externalQuoteNo != null and externalQuoteNo != ''">external_quote_no,</if>
            <if test="sourceSystem != null">source_system,</if>
            <if test="title != null">title,</if>
            <if test="clientCode != null">client_code,</if>
