    <!-- 回写状态更新（定时任务无登录上下文，显式 factory_id） -->
    <update id="updateSyncStatus">
        update qxx_sal_quote
        set sync_status = #{syncStatus}, sync_time = #{syncTime}
        where quote_id = #{quoteId} and factory_id = #{factoryId}
    </update>

