            <if test="locationId != null">#{locationId},</if>
            <if test="areaId != null">#{areaId},</if>
            <if test="materialStockId != null">#{materialStockId},</if>
            <if test="status != null">#{status},</if>
            <if test="extAttrs != null">#{extAttrs, typeHandler=com.ruoyi.common.core.handler.JsonMapTypeHandler},</if>
            <if test="remark != null">#{remark},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
        </trim>
    </insert>

    <update id="updateWmStockInstance" parameterType="com.ruoyi.system.domain.mes.wm.WmStockInstance">
        update qxx_wm_stock_instance
        <trim prefix="SET" suffixOverrides=",">
            <if test="instanceCode != null">instance_code = #{instanceCode},</if>
            <if test="instanceType != null">instance_type = #{instanceType},</if>
            <if test="itemId != null">item_id = #{itemId},</if>
            <if test="itemCode != null">item_code = #{itemCode},</if>
            <if test="itemName != null">item_name = #{itemName},</if>
            <if test="specification != null">specification = #{specification},</if>
            <if test="batchId != null">batch_id = #{batchId},</if>
            <if test="batchCode != null">batch_code = #{batchCode},</if>
            <if test="vendorInstanceNo != null">vendor_instance_no = #{vendorInstanceNo},</if>
            <if test="originalQuantity != null">original_quantity = #{originalQuantity},</if>
            <if test="remainingQuantity != null">remaining_quantity = #{remainingQuantity},</if>
            <if test="quantityUom != null">quantity_uom = #{quantityUom},</if>
            <if test="warehouseId != null">warehouse_id = #{warehouseId},</if>
            <if test="warehouseCode != null">warehouse_code = #{warehouseCode},</if>
            <if test="warehouseName != null">warehouse_name = #{warehouseName},</if>
            <if test="materialStockId != null">material_stock_id = #{materialStockId},</if>
            <if test="status != null">status = #{status},</if>
            <if test="extAttrs != null">ext_attrs = #{extAttrs, typeHandler=com.ruoyi.common.core.handler.JsonMapTypeHandler},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
        </trim>
        where instance_id = #{instanceId}
    </update>

    <update id="adjustRemaining">
        update qxx_wm_stock_instance
        set remaining_quantity = remaining_quantity + #{delta},
            update_by = #{operator},
            update_time = #{now}
            <if test="status != null and status != ''">, status = #{status}</if>
            <if test="lastIssueId != null">, last_issue_id = #{lastIssueId}</if>
            <if test="lastWorkorderId != null">, last_workorder_id = #{lastWorkorderId}</if>
            <if test="lastWorkorderCode != null and lastWorkorderCode != ''">, last_workorder_code = #{lastWorkorderCode}</if>
        where instance_id = #{instanceId}
          and remaining_quantity + #{delta} &gt;= 0
    </update>

    <delete id="deleteWmStockInstanceById" parameterType="Long">
        delete from qxx_wm_stock_instance where instance_id = #{instanceId}
    </delete>

    <delete id="deleteWmStockInstanceByIds" parameterType="String">
        delete from qxx_wm_stock_instance where instance_id in
        <foreach item="instanceId" collection="array" open="(" separator="," close=")">
            #{instanceId}
        </foreach>
    </delete>

</mapper>
