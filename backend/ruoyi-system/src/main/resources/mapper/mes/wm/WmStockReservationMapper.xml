    <select id="sumActiveByItem" parameterType="WmStockReservation" resultType="java.math.BigDecimal">
        select coalesce(sum(reserved_qty), 0)
        from qxx_wm_stock_reservation
        where item_id = #{itemId}
          and status in ('OPEN', 'PARTIAL', 'RESERVED')
        <if test="factoryId != null"> and factory_id = #{factoryId}</if>
    </select>

    <select id="sumActiveByWorkorderItem" parameterType="WmStockReservation" resultType="java.math.BigDecimal">
