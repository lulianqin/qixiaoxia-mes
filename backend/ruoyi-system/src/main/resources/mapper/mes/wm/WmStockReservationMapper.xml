    <sql id="selectReservationVo">
        select reservation_id, factory_id, material_stock_id, item_id, item_code, item_name, specification,
               unit_of_measure, unit_name, warehouse_id, warehouse_code, warehouse_name, batch_id, batch_code,
               workorder_id, workorder_code, workorder_name, sales_order_id, sales_order_line_id,
               source_doc_type, source_doc_id, source_doc_code, source_line_id,
               issue_id, issue_code, source_type, demand_qty, reserved_qty, consumed_qty, released_qty, transferred_qty,
               demand_date, status, remark, create_by, create_time, update_by, update_time
        from qxx_wm_stock_reservation
    </sql>

    <select id="selectWmStockReservationList" parameterType="WmStockReservation" resultMap="WmStockReservationResult">
        <include refid="selectReservationVo"/>
        <where>
            <if test="itemId != null"> and item_id = #{itemId}</if>
            <if test="itemCode != null and itemCode != ''"> and item_code like concat('%', #{itemCode}, '%')</if>
            <if test="itemName != null and itemName != ''"> and item_name like concat('%', #{itemName}, '%')</if>
            <if test="workorderId != null"> and workorder_id = #{workorderId}</if>
            <if test="workorderCode != null and workorderCode != ''"> and workorder_code like concat('%', #{workorderCode}, '%')</if>
            <if test="materialStockId != null"> and material_stock_id = #{materialStockId}</if>
            <if test="issueId != null"> and issue_id = #{issueId}</if>
            <if test="status != null and status != ''"> and status = #{status}</if>
            <if test="sourceType != null and sourceType != ''"> and source_type = #{sourceType}</if>
            <if test="sourceDocType != null and sourceDocType != ''"> and source_doc_type = #{sourceDocType}</if>
            <if test="sourceDocId != null"> and source_doc_id = #{sourceDocId}</if>
            <if test="warehouseId != null"> and warehouse_id = #{warehouseId}</if>
        </where>
        order by demand_date asc, reservation_id asc
    </select>

    <select id="selectWmStockReservationById" parameterType="Long" resultMap="WmStockReservationResult">
        <include refid="selectReservationVo"/>
        where reservation_id = #{reservationId}
    </select>

    <select id="selectActiveByItem" parameterType="WmStockReservation" resultMap="WmStockReservationResult">
        <include refid="selectReservationVo"/>
        where item_id = #{itemId}
          and status in ('OPEN', 'PARTIAL', 'RESERVED')
        <if test="factoryId != null"> and factory_id = #{factoryId}</if>
        order by demand_date asc, reservation_id asc
    </select>

    <select id="selectByWorkorder" parameterType="WmStockReservation" resultMap="WmStockReservationResult">
        <include refid="selectReservationVo"/>
        where workorder_id = #{workorderId}
        <if test="itemId != null"> and item_id = #{itemId}</if>
        <if test="factoryId != null"> and factory_id = #{factoryId}</if>
        order by item_id asc, reservation_id asc
    </select>

    <select id="selectByIssue" parameterType="WmStockReservation" resultMap="WmStockReservationResult">
        <include refid="selectReservationVo"/>
        where issue_id = #{issueId}
        <if test="factoryId != null"> and factory_id = #{factoryId}</if>
